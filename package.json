{
  "name": "pvmizer",
  "version": "2.0.0",
  "description": "3D Solar Panel Roof Simulation with real-time sun tracking and energy calculations",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis"
  },
  "dependencies": {
    "chart.js": "^4.4.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.1.0",
    "three": "^0.163.0"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.kubis.pvmizer",
    "productName": "PVMizer 2.0",
    "copyright": "Copyright © 2024",
    "asar": false,
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "index.html",
      "style.css",
      "electron/**/*",
      "assets/**/*",
      "!node_modules"
    ],
    "extraFiles": [
      {
        "from": "node_modules/three",
        "to": "resources/app/node_modules/three"
      },
      {
        "from": "node_modules/chart.js",
        "to": "resources/app/node_modules/chart.js"
      },
      {
        "from": "node_modules/@kurkle",
        "to": "resources/app/node_modules/@kurkle"
      },
      {
        "from": "node_modules/jspdf",
        "to": "resources/app/node_modules/jspdf"
      },
      {
        "from": "node_modules/html2canvas",
        "to": "resources/app/node_modules/html2canvas"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/project_icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PVMizer 2.0",
      "installerIcon": "assets/project_icon.png",
      "uninstallerIcon": "assets/project_icon.png",
      "installerHeader": "",
      "uninstallDisplayName": "PVMizer 2.0"
    },
    "afterPack": "scripts/afterPack.js",
    "portable": {
      "artifactName": "${productName} ${version} Portable.exe"
    }
  }
}
